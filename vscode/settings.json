{
  "editor.fontFamily": "FiraCode Nerd Font Mono, Menlo, Monaco, 'Courier New', monospace",
  "workbench.colorCustomizations": {
    "[Atom One Darker]": {
      // Darker - #14161a
      // Deep:
      // "activityBar.background": "#161a24",
      // "activityBar.border": "#2c2c31",
      // "statusBar.background": "#161a24",
      // "statusBar.border": "#2c2c31",
      // "titleBar.activeBackground": "#161a24",
      // "titleBar.inactiveBackground": "#161a24",
      // "titleBar.border": "#2c2c31",
      // "sideBar.background": "#161a24",
      // "sideBar.border": "#2c2c31",
      // "tab.inactiveBackground": "#161a24",
      // "tab.activeBackground": "#2c2c31",
      // "tab.activeBorderTop": "#0065ba",
      // "editorGroupHeader.tabsBackground": "#161a24",
      // "editor.background": "#161a24"
      // Cool:
      "activityBar.background": "#21252B",
      "activityBar.border": "#2c2c31",
      "statusBar.background": "#21252B",
      "statusBar.border": "#2c2c31",
      "titleBar.activeBackground": "#21252B",
      "titleBar.inactiveBackground": "#21252B",
      "titleBar.border": "#2c2c31",
      "sideBar.background": "#21252B",
      "sideBar.border": "#2c2c31",
      "tab.inactiveBackground": "#21252B",
      "tab.activeBackground": "#2c2c31",
      "tab.activeBorderTop": "#0065ba",
      "editorGroupHeader.tabsBackground": "#21252B",
      "editor.background": "#282C34",
      "editor.selectionBackground": "#758ab17b",
    }
  },
  "editor.tokenColorCustomizations": {
    "[*]": {
      // "comments": "#4d556a",
      "comments": "#888888",
      // "strings": "#95D567",
      "strings": "#71d562",
    },
    "textMateRules": [
      {
        "name": "Python Docstring",
        "scope": [
          "string.quoted.docstring.multi.python"
        ],
        "settings": {
          "foreground": "#6e6e6e"
        }
      },
      {
        "scope": "markup.inline.raw.string.markdown",
        "settings": {
          "foreground": "#95d567"
        }
      },
    ],
  },
  // OPTIONS: Text Editor
  "editor.fontSize": 14,
  "editor.renderWhitespace": "none",
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.wordWrap": "on",
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.linkedEditing": true,
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.cursorBlinking": "phase",
  "editor.find.cursorMoveOnType": false,
  "editor.fontLigatures": "'ss02', 'ss05', 'ss08' on, 'cv02', 'cv16', 'cv25', 'cv26', 'cv30'",
  "editor.minimap.enabled": false,
  "editor.minimap.autohide": true,
  "editor.accessibilitySupport": "off",
  "explorer.compactFolders": false,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "workbench.panel.opensMaximized": "never",
  "workbench.startupEditor": "none",
  "workbench.preferredDarkColorTheme": "Atom One Darker",
  "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.view.alwaysShowHeaderActions": true,
  "files.exclude": {
    "**/*.dSYM": true
  },
  // OPTIONS: Features
  "explorer.sortOrder": "type",
  "explorer.confirmDelete": false,
  // Terminal
  "terminal.explorerKind": "external",
  "terminal.external.osxExec": "WezTerm.app",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  // LANGUAGE SPECIFIC
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.formatOnSave": true,
    "editor.wordBasedSuggestions": "off",
    "editor.rulers": [
      {
        "column": 79,
        "color": "#242731"
      }
    ],
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
  },
  "isort.args": [
    "--profile",
    "black"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  // BETTER COMMENTS
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF2D00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#3498DB",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "//",
      "color": "#474747",
      "strikethrough": true,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "todo",
      "color": "#FF8C00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "~",
      "color": "#00c8ff",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.sideBar.location": "right",
  "git.confirmSync": false,
  // Web Dev
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.formatOnSave": true,
  "black-formatter.args": [
    "--skip-string-normalization",
    "--line-length",
    "79"
  ],
  "workbench.iconTheme": "vscode-icons",
  "C_Cpp.default.cppStandard": "c++20",
  "clang-format.executable": "clang-format",
  // "clang-format.style": "{ BasedOnStyle: LLVM, UseTab: Never, IndentWidth: 4, ColumnLimit: 80, IndentCaseLabels: true, SortIncludes: true, IncludeBlocks: Regroup }",
  "clang-format.style": "{ Language: Cpp, BasedOnStyle: LLVM, AccessModifierOffset: -4, AlignConsecutiveAssignments: false, AlignConsecutiveDeclarations: false, AlignOperands: Align, AlignTrailingComments: { Kind: Always, OverEmptyLines: 1 }, AllowShortIfStatementsOnASingleLine: WithoutElse, BraceWrapping: { AfterCaseLabel: false, AfterClass: false, AfterControlStatement: MultiLine, AfterEnum: false, AfterFunction: false, AfterNamespace: false, AfterStruct: false, AfterUnion: false, AfterExternBlock: false, BeforeCatch: true, BeforeElse: true, BeforeLambdaBody: false, BeforeWhile: false, SplitEmptyFunction: false, SplitEmptyRecord: false, SplitEmptyNamespace: false }, BreakBeforeBraces: Custom, BreakTemplateDeclarations: Yes, ColumnLimit: 80, IncludeBlocks: Regroup, IncludeCategories: [ { Regex: '^\".*', Priority: 1 }, { Regex: '^<.*', Priority: 2 }, { Regex: '.*', Priority: 3 } ], IncludeIsMainRegex: '([-_](test|unittest))?$', IndentCaseLabels: true, IndentWidth: 4, InsertNewlineAtEOF: true, MacroBlockBegin: '', MacroBlockEnd: '', MaxEmptyLinesToKeep: 1, NamespaceIndentation: All, SortIncludes: CaseInsensitive, SpaceAfterCStyleCast: true, SpaceAfterTemplateKeyword: false, SpacesInParens: Never, SpacesInAngles: false, TabWidth: 4, UseTab: Never }",
  "clangd.fallbackFlags": [
    "-std=c++20",
    "-I${workspaceFolder}/include",
    "-I${workspaceFolder}/includes",
    "-Wall",
    ""
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "include",
    "includes",
  ],
  "[c][cpp]": {
    "editor.rulers": [
      {
        "column": 99,
        "color": "#242731"
      }
    ],
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.semanticHighlighting.enabled": true,
  },
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "window.newWindowProfile": "Base",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "git.autofetch": true,
  "makefile.configureOnOpen": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
}